# Copie ce fichier en .env.local et remplis-le. Ne commite JAMAIS .env.local.
# Dashboard Supabase > Project Settings > API (et API Keys)

# --- Serveur uniquement (pages/api/*) : accès complet à la base, contourne la RLS ---
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxx

# --- Navigateur : authentification uniquement. La clé "anon" est publique par conception ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxx

# --- Optionnel : si défini, getUserId() vérifie les jetons localement (HS256) au lieu d'appeler Supabase.
#     Absent en production à ce jour. ---
# SUPABASE_JWT_SECRET=

# --- Tâche planifiée Vercel (abonnements récurrents) : en-tête Authorization: Bearer <CRON_SECRET> ---
CRON_SECRET=une-longue-chaine-aleatoire

# --- Stripe (mode TEST à ce jour) ---
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_PRICE_CONFIRME=price_xxxxxxxx
STRIPE_PRICE_INVESTISSEUR=price_xxxxxxxx
